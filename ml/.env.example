# --- ML service environment variables ---
# This file is committed to the repo. Copy to `.env` and fill in real
# values for local development. DO NOT commit `.env`.
#
# All vars are prefixed with ML_ — see app/config.py for the schema.

# Database (asyncpg connection string)
# In docker-compose, this is the postgres service on the dev network.
# Local: postgresql://smartbanking:smartbanking@localhost:5432/smartbanking
ML_DB_URL=postgresql://ml:changeme@postgres:5432/smartbanking

# Path to the ONNX model file. If missing at startup, the service
# falls back to rules-based scoring (see app/core/rules.py).
ML_MODEL_PATH=models/fraud_model.onnx

# Score thresholds (0.0 – 1.0)
# score <  ML_THRESHOLD_SUSPICIOUS  → CLEAR
# score >= suspicious AND < blocked → SUSPICIOUS (extra OTP)
# score >= ML_THRESHOLD_BLOCKED      → BLOCKED
ML_THRESHOLD_SUSPICIOUS=0.5
ML_THRESHOLD_BLOCKED=0.8

# Python log level: DEBUG, INFO, WARNING, ERROR
ML_LOG_LEVEL=INFO
